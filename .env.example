# Server Port (opcional - Render fornece via variável PORT)
PORT=3000

# Zendesk Configuration
ZENDESK_SUBDOMAIN=seu_subdominio
ZENDESK_APP_ID=seu_app_id
ZENDESK_KEY_ID=sua_chave_id
ZENDESK_SECRET=seu_segredo

# Webview URL (opcional em desenvolvimento)
# Em produção, use: https://seu-projeto.onrender.com/webview
WEBVIEW_URL=http://localhost:3000/webview

# VTEX Catalog Configuration
# Cada bot/instância aponta para uma loja VTEX diferente. Use o parâmetro
# ?store=mizuno|olympikus|underarmour nas rotas /api/catalog/* para escolher.

# Mizuno
VTEX_MIZUNO_STORE_URL=mizunobr.vtexcommercestable.com.br
VTEX_MIZUNO_API_KEY=sua_chave_vtex
VTEX_MIZUNO_API_TOKEN=seu_token_vtex

# Olympikus
VTEX_OLYMPIKUS_STORE_URL=olympikus.vtexcommercestable.com.br
VTEX_OLYMPIKUS_API_KEY=sua_chave_vtex
VTEX_OLYMPIKUS_API_TOKEN=seu_token_vtex

# Under Armour
VTEX_UNDERARMOUR_STORE_URL=underarmourbr.vtexcommercestable.com.br
VTEX_UNDERARMOUR_API_KEY=sua_chave_vtex
VTEX_UNDERARMOUR_API_TOKEN=seu_token_vtex

# Node Environment
NODE_ENV=development
