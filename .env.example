# Server Port (opcional - Render fornece via variável PORT)
PORT=3000

# Zendesk Configuration
ZENDESK_SUBDOMAIN=seu_subdominio
ZENDESK_APP_ID=seu_app_id
ZENDESK_KEY_ID=sua_chave_id
ZENDESK_SECRET=seu_segredo

# Webview URL (opcional em desenvolvimento)
# Em produção, use: https://seu-projeto.onrender.com/webview
WEBVIEW_URL=http://localhost:3000/webview

# VTEX Catalog Configuration
# Cada bot/instância aponta para uma loja VTEX diferente. Use o parâmetro
# ?store=mizuno|olympikus|underarmour nas rotas /api/catalog/* para escolher.

# Mizuno
VTEX_MIZUNO_STORE_URL=mizunobr.vtexcommercestable.com.br
VTEX_MIZUNO_API_KEY=sua_chave_vtex
VTEX_MIZUNO_API_TOKEN=seu_token_vtex

# Olympikus
VTEX_OLYMPIKUS_STORE_URL=olympikus.vtexcommercestable.com.br
VTEX_OLYMPIKUS_API_KEY=sua_chave_vtex
VTEX_OLYMPIKUS_API_TOKEN=seu_token_vtex

# Under Armour
VTEX_UNDERARMOUR_STORE_URL=underarmourbr.vtexcommercestable.com.br
VTEX_UNDERARMOUR_API_KEY=sua_chave_vtex
VTEX_UNDERARMOUR_API_TOKEN=seu_token_vtex

# Troque Commerce (um token por marca; o token define a loja)
TROQUE_MCP_URL=https://www.troquecommerce.com.br/api/mcp
TROQUE_MIZUNO_TOKEN=
TROQUE_OLYMPIKUS_TOKEN=
TROQUE_UNDERARMOUR_TOKEN=

# Zendesk Tickets (OAuth 2.0 Authorization Code)
ZENDESK_OAUTH_CLIENT_ID=
ZENDESK_OAUTH_CLIENT_SECRET=
ZENDESK_OAUTH_REDIRECT_URI=https://seu-app.onrender.com/oauth/zendesk/callback
ZENDESK_OAUTH_SCOPES=read write
ZENDESK_BRAND_ID_MIZUNO=
ZENDESK_BRAND_ID_OLYMPIKUS=
ZENDESK_BRAND_ID_UNDERARMOUR=
ZENDESK_TICKET_SUBJECT=Troca/Devolução via webview

# Sessão e administração
# FLOW_SESSION_SECRET: no mínimo 32 caracteres aleatórios
# (ex.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
FLOW_SESSION_SECRET=
FLOW_SESSION_TTL_MINUTES=60
# Sal do hash do número do pedido no rastreamento (não trocar depois de em uso)
FLOW_HASH_SALT=
ADMIN_SECRET=
# Segredo que o bot envia no POST /api/send-webview (header X-Api-Secret ou
# Authorization: Bearer). Vazio = endpoint aberto, como hoje. Cadastre o header
# no Ultimate ANTES de definir esta variável.
WEBVIEW_API_SECRET=

# Motivos do Troque que vão para um atendente em vez de abrir a reversa
# (texto exato do motivo; vários separados por "|")
REVERSE_HANDOFF_REASONS=Solicitação fora do prazo
# Botão "Falar com atendente" postado na conversa para o bot reconhecer.
# reply = resposta rápida (o cliente "diz" o texto do botão no chat);
# postback = só o payload, como evento. Configure o bot para o texto/payload.
REVERSE_HANDOFF_BUTTON_TYPE=reply
REVERSE_HANDOFF_BUTTON_TEXT=Falar com atendente
REVERSE_HANDOFF_PAYLOAD=REVERSE_HANDOFF

# Node Environment
NODE_ENV=development
